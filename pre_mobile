<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Your Future Starts Here — Education Guide 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--cream:#F7F4EE;--ink:#1A1714;--sage:#4A6741;--sage-light:#EBF0E8;--gold:#C8963E;--gold-light:#FBF3E4;--rose:#B85C4A;--rose-light:#FAF0EE;--slate:#3D5A73;--slate-light:#EAF0F5;--muted:#7A7068;--border:rgba(26,23,20,0.1);--nav-h:60px;--tab-h:64px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--ink);min-height:100vh;overflow-x:hidden}

/* TOP NAV */
.top-nav{position:fixed;top:0;left:0;right:0;z-index:200;background:rgba(247,244,238,.94);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--border);height:var(--nav-h);display:flex;align-items:center;justify-content:space-between;padding:0 2rem}
.nav-brand{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--ink);text-decoration:none;white-space:nowrap}
.nav-brand span{color:var(--sage)}
.nav-links{display:flex;gap:.2rem;list-style:none}
.nav-links a{text-decoration:none;font-size:.82rem;font-weight:500;color:var(--muted);padding:6px 14px;border-radius:999px;transition:all .2s;white-space:nowrap}
.nav-links a:hover,.nav-links a.active{background:var(--ink);color:var(--cream)}

/* BOTTOM TAB BAR (mobile) */
.tab-bar{display:none;position:fixed;bottom:0;left:0;right:0;z-index:200;background:rgba(247,244,238,.97);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:1px solid var(--border);height:var(--tab-h);align-items:stretch}
.tab-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;background:none;border:none;cursor:pointer;padding:6px 4px;transition:all .18s;-webkit-tap-highlight-color:transparent}
.tab-btn .tab-icon{font-size:1.25rem;line-height:1}
.tab-btn .tab-label{font-size:.62rem;font-weight:500;color:var(--muted);letter-spacing:.02em;transition:color .18s}
.tab-btn.active .tab-label{color:var(--sage);font-weight:600}
.tab-btn.active .tab-icon{transform:translateY(-1px)}

/* PAGES */
.page{display:none;min-height:100vh;padding-top:calc(var(--nav-h) + 1.5rem);padding-bottom:3rem}
.page.active{display:block}
.container{max-width:960px;margin:0 auto;padding:0 1.5rem}

/* HERO */
.hero-section{padding:2.5rem 0 2rem;text-align:center}
.hero-tag{display:inline-block;font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--sage);background:var(--sage-light);border:1px solid rgba(74,103,65,.2);padding:5px 14px;border-radius:999px;margin-bottom:1.25rem}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(2rem,8vw,4rem);font-weight:900;line-height:1.1;color:var(--ink);margin-bottom:1rem}
.hero-title em{font-style:italic;color:var(--sage)}
.hero-sub{font-size:.98rem;color:var(--muted);max-width:480px;margin:0 auto 2rem;line-height:1.7}

/* PROFILE PILLS */
.profile-card{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-bottom:2rem}
.profile-pill{background:white;border:1px solid var(--border);border-radius:999px;padding:.5rem 1.1rem;box-shadow:0 2px 8px rgba(0,0,0,.05);text-align:center}
.profile-pill-val{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--ink);display:block}
.profile-pill-label{font-size:.66rem;color:var(--muted);font-weight:500;letter-spacing:.04em;white-space:nowrap}

/* URGENT BANNER */
.urgent-banner{background:var(--rose);color:white;border-radius:14px;padding:1rem 1.25rem;display:flex;align-items:flex-start;gap:.85rem;margin-bottom:2rem}
.urgent-dot{width:10px;height:10px;background:white;border-radius:50%;flex-shrink:0;margin-top:5px;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.4)}}
.urgent-text{font-size:.86rem;line-height:1.6}
.urgent-text strong{font-weight:600}
.urgent-text a{color:white;font-family:'DM Mono',monospace;font-size:.76rem;word-break:break-all}

/* SECTION HEADER */
.section-header{margin-bottom:1.5rem}
.section-eyebrow{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.4rem;display:block}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(1.4rem,4vw,1.9rem);font-weight:700;color:var(--ink);line-height:1.2}

/* CTA GRID */
.cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem;margin-bottom:2.5rem}
.cta-card{background:white;border:1.5px solid var(--border);border-radius:16px;padding:1rem 1rem 1.15rem;cursor:pointer;transition:transform .2s,box-shadow .2s;text-align:left;position:relative;overflow:hidden;-webkit-tap-highlight-color:transparent}
.cta-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0}
.cta-card.c-sage::before{background:var(--sage)}.cta-card.c-gold::before{background:var(--gold)}.cta-card.c-rose::before{background:var(--rose)}.cta-card.c-slate::before{background:var(--slate)}
.cta-card:active{transform:scale(.97)}
.cta-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1rem;margin-bottom:.55rem}
.cta-card.c-sage .cta-icon{background:var(--sage-light)}.cta-card.c-gold .cta-icon{background:var(--gold-light)}.cta-card.c-rose .cta-icon{background:var(--rose-light)}.cta-card.c-slate .cta-icon{background:var(--slate-light)}
.cta-title{font-weight:600;font-size:.88rem;color:var(--ink);margin-bottom:3px}
.cta-desc{font-size:.74rem;color:var(--muted);line-height:1.45}
.cta-arrow{position:absolute;top:1rem;right:1rem;font-size:.88rem;color:var(--muted)}

/* INFO ROW */
.info-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.7rem;margin-bottom:1.5rem}
.info-box{background:white;border:1px solid var(--border);border-radius:12px;padding:.85rem 1rem}
.info-label{font-size:.65rem;color:var(--muted);font-weight:500;letter-spacing:.04em;margin-bottom:4px;text-transform:uppercase}
.info-val{font-family:'Playfair Display',serif;font-size:1.15rem;font-weight:700;color:var(--ink)}
.info-val.small{font-size:.86rem;font-family:'DM Sans',sans-serif;font-weight:600}

/* CALLOUT */
.callout{border-radius:12px;padding:.9rem 1.1rem;font-size:.85rem;line-height:1.7;margin-bottom:1.5rem}
.callout.sage{background:var(--sage-light);border-left:3px solid var(--sage);color:#2A3E26}
.callout.gold{background:var(--gold-light);border-left:3px solid var(--gold);color:#5A3E10}
.callout.rose{background:var(--rose-light);border-left:3px solid var(--rose);color:#6B2A1E}
.callout.slate{background:var(--slate-light);border-left:3px solid var(--slate);color:#1E3548}

/* BADGES */
.course-badge{font-size:.67rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:3px 9px;border-radius:999px;display:inline-block;margin-bottom:6px}
.badge-sage{background:var(--sage-light);color:var(--sage)}.badge-gold{background:var(--gold-light);color:#8B5E1A}.badge-rose{background:var(--rose-light);color:var(--rose)}.badge-slate{background:var(--slate-light);color:var(--slate)}.badge-muted{background:rgba(122,112,104,.12);color:var(--muted)}

/* COURSE CARDS */
.course-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-bottom:2rem}
.course-card{background:white;border:1px solid var(--border);border-radius:16px;overflow:hidden}
.course-card-header{padding:1.1rem 1.1rem .9rem;border-bottom:1px solid var(--border)}
.course-card-name{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:var(--ink);margin-bottom:4px}
.course-card-sub{font-size:.8rem;color:var(--muted);line-height:1.5}
.course-card-body{padding:.9rem 1.1rem}
.course-detail-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(26,23,20,.05);font-size:.81rem;gap:.5rem}
.course-detail-row:last-child{border-bottom:none}
.detail-label{color:var(--muted);flex-shrink:0}.detail-val{color:var(--ink);font-weight:500;text-align:right}

/* SCROLLABLE TABLE */
.table-scroll-hint{font-size:.7rem;color:var(--muted);text-align:right;margin-bottom:4px;font-family:'DM Mono',monospace;display:none}
.table-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:14px;border:1px solid var(--border);margin-bottom:1.5rem}
.data-table{width:100%;min-width:540px;border-collapse:collapse;background:white;font-size:.82rem}
.data-table th{background:var(--ink);color:var(--cream);padding:10px 12px;text-align:left;font-weight:500;font-size:.74rem;letter-spacing:.04em;white-space:nowrap}
.data-table td{padding:10px 12px;border-bottom:1px solid rgba(26,23,20,.06);color:var(--ink);vertical-align:top;line-height:1.5}
.data-table tr:last-child td{border-bottom:none}
.data-table tr:nth-child(even) td{background:rgba(247,244,238,.6)}

/* SALARY */
.salary-section{margin-bottom:2rem}
.salary-row{margin-bottom:1.1rem}
.salary-meta{display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem;margin-bottom:5px;flex-wrap:wrap}
.salary-title{font-size:.84rem;font-weight:500;color:var(--ink)}
.salary-amount{font-family:'DM Mono',monospace;font-size:.79rem;color:var(--sage);font-weight:500;white-space:nowrap}
.salary-bar-bg{background:rgba(26,23,20,.08);border-radius:999px;height:6px;overflow:hidden}
.salary-bar-fill{height:6px;border-radius:999px;background:var(--sage)}

/* STEP LIST */
.step-list{list-style:none}
.step-item{display:flex;gap:1rem;padding:1.1rem 0;border-bottom:1px solid var(--border);align-items:flex-start}
.step-item:last-child{border-bottom:none}
.step-num{min-width:30px;height:30px;border-radius:50%;background:var(--ink);color:var(--cream);font-size:.78rem;font-weight:600;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.step-title{font-weight:600;font-size:.9rem;color:var(--ink);margin-bottom:4px}
.step-desc{font-size:.81rem;color:var(--muted);line-height:1.65}
.step-desc strong{color:var(--ink);font-weight:500}
.step-links{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}
.step-link{font-family:'DM Mono',monospace;font-size:.7rem;color:var(--slate);background:var(--slate-light);padding:3px 9px;border-radius:6px;text-decoration:none;word-break:break-all}

/* COMPARE */
.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem}
.compare-col{background:white;border:1.5px solid var(--border);border-radius:16px;overflow:hidden}
.compare-header{padding:.9rem 1rem;border-bottom:1px solid var(--border)}
.compare-header-title{font-weight:600;font-size:.88rem;color:var(--ink)}
.compare-header-sub{font-size:.72rem;color:var(--muted);margin-top:2px}
.compare-body{padding:.6rem 1rem}
.compare-row{display:flex;gap:7px;padding:6px 0;font-size:.78rem;color:var(--ink);border-bottom:1px solid rgba(26,23,20,.05);align-items:flex-start;line-height:1.4}
.compare-row:last-child{border-bottom:none}
.compare-icon{flex-shrink:0;font-size:.76rem;margin-top:1px}
.check{color:var(--sage)}.cross{color:var(--rose)}

/* TIMELINE */
.timeline{position:relative;padding-left:1.8rem}
.timeline::before{content:'';position:absolute;left:7px;top:0;bottom:0;width:2px;background:var(--border)}
.timeline-item{position:relative;margin-bottom:1.75rem}
.timeline-dot{position:absolute;left:-1.8rem;top:4px;width:16px;height:16px;border-radius:50%;background:white;border:2px solid var(--sage)}
.timeline-dot.filled{background:var(--sage)}
.timeline-year{font-family:'DM Mono',monospace;font-size:.67rem;color:var(--muted);letter-spacing:.06em;margin-bottom:3px}
.timeline-role{font-weight:600;font-size:.9rem;color:var(--ink)}
.timeline-salary{font-family:'DM Mono',monospace;font-size:.75rem;color:var(--sage);margin-top:2px}
.timeline-detail{font-size:.79rem;color:var(--muted);margin-top:3px;line-height:1.5}

/* DOC GRID */
.doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:.65rem;margin-bottom:1.5rem}
.doc-item{background:white;border:1px solid var(--border);border-radius:10px;padding:.78rem .9rem;font-size:.81rem;color:var(--ink);line-height:1.4}
.doc-item span{display:block;font-size:.68rem;color:var(--muted);margin-top:2px}

/* SCHOLAR */
.scholar-list{list-style:none}
.scholar-item{background:white;border:1px solid var(--border);border-radius:12px;padding:.88rem 1.1rem;margin-bottom:.6rem;display:flex;gap:.85rem;align-items:flex-start}
.scholar-dot{min-width:8px;height:8px;border-radius:50%;background:var(--sage);margin-top:6px;flex-shrink:0}
.scholar-name{font-weight:600;font-size:.88rem;color:var(--ink)}
.scholar-detail{font-size:.79rem;color:var(--muted);line-height:1.55;margin-top:3px}
.scholar-benefit{display:inline-block;font-family:'DM Mono',monospace;font-size:.68rem;color:var(--sage);background:var(--sage-light);padding:2px 8px;border-radius:6px;margin-top:5px;word-break:break-all}

/* DIVIDER */
.divider{height:1px;background:var(--border);margin:2rem 0}

/* FADE */
.fade-in{animation:fadeUp .45s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}

/* FOOTER */
footer{background:var(--ink);color:rgba(247,244,238,.6);padding:1.75rem 1.5rem;text-align:center;font-size:.77rem;line-height:1.8}
footer strong{color:var(--cream)}
footer a{color:rgba(247,244,238,.5);font-family:'DM Mono',monospace;font-size:.7rem;word-break:break-all}
.footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem 1rem;margin-top:.5rem}

/* ══ MOBILE ≤ 768px ══ */
@media(max-width:768px){
  .top-nav{display:none}
  .tab-bar{display:flex}
  .page{padding-top:1.25rem;padding-bottom:calc(var(--tab-h) + 1rem)}
  .container{padding:0 1rem}
  .hero-section{padding:1.5rem 0 1.25rem}
  .cta-arrow{display:none}
  .course-grid{grid-template-columns:1fr}
  .compare-grid{grid-template-columns:1fr}
  .table-scroll-hint{display:block}
}

/* ══ SMALL PHONES ≤ 420px ══ */
@media(max-width:420px){
  .hero-title{font-size:1.9rem}
  .cta-grid{grid-template-columns:1fr}
  .info-row{grid-template-columns:1fr 1fr}
  .doc-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>
